# 指纹共享平台配置模板。复制为 .env 后填写，.env 不进 Git。
# 生成 ADMIN_PASSWORD_HASH：
#   D:\reverse_ENV\.venv\Scripts\python.exe scripts\hash_password.py
ADMIN_PASSWORD_HASH=
# FP_SECRET_KEY：itsdangerous session 签名密钥
#   D:\reverse_ENV\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
FP_SECRET_KEY=
FP_DB_PATH=data/fingerprint_share.db
FP_HOST=127.0.0.1
FP_PORT=8000
FP_SESSION_MAX_AGE=43200
