{
  "manifest_version": 3,
  "name": "BOSS-zhipin.com 指纹采集插件",
  "version": "1.0",
  "description": "BOSS 直聘 security-js 设备指纹面：WebGL readPixels 行为 / 设备指纹字段组合 / console 序列化侧信道 / 输入事件面 / 资源域名分组",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BOSS-zhipin.com"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fp-boss-zhipin.com@fingerprint-share.local"
    }
  }
}
